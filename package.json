{
  "name": "llm-monitor",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bench": "bun run src/bench/index.ts",
    "cron": "bun run src/bench/cron.ts",
    "web": "bun run src/web/index.ts",
    "web:dev": "bun --watch src/web/index.ts",
    "test": "bun test",
    "lint": "bunx biome check src/",
    "fmt": "bunx biome check --write src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
