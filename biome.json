{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/specs/",
      "!**/src/web/static/**/*.html",
      "!**/node_modules/",
      "!**/dist/",
      "!**/data/",
      "!**/*.db",
      "!**/bun.lock"
    ]
  }
}
